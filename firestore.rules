rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function isAdmin() { return hasProfile() && get(userPath()).data.role == 'admin'; }
    function isActive() { return hasProfile() && get(userPath()).data.status == 'active'; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['name', 'phone', 'photoURL', 'pushTokens', 'updatedAt']);
      allow update: if isAdmin() && request.auth.uid != uid
        && onlyChanges(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'suspended'];
      allow create, delete: if false;
    }

    match /invites/{code} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && onlyChanges(['status', 'revokedAt']);
      allow create, delete: if false;
    }

    // Menü ve kantin durumu herkese açık: giriş yapmadan menüye göz atılabilir
    // (App Store 5.1.1(v): hesap gerektirmeyen içerik kayıtsız görülebilmeli). Yazma yalnız admin.
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if id == 'shop' || isActive(); allow write: if isAdmin(); }
    match /queue/{id}      { allow read: if isActive(); allow write: if false; }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin();
      // öğrenci: henüz bekleyen siparişini iptal eder
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'user'
        && request.resource.data.closedAt == request.time
        && onlyChanges(['status', 'cancelledBy', 'closedAt', 'updatedAt']);
      // öğrenci: okunmamış mesaj sayacını sıfırlar
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.unreadForUser == 0
        && onlyChanges(['unreadForUser']);

      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
        function isOwner() { return signedIn() && parent().userId == request.auth.uid; }
        allow read: if isAdmin() || isOwner();
        allow create: if (isAdmin() || (isOwner() && isActive()))
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'user')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && parent().status in ['pending', 'preparing', 'ready'];
        allow update, delete: if false;
      }
    }

    match /stockItems/{id} { allow read, write: if isAdmin(); }
    match /dailyStats/{id} { allow read: if isAdmin(); allow write: if false; }
    match /counters/{id}   { allow read, write: if false; }
  }
}
