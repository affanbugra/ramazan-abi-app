# Firebase Console → Proje ayarları → Genel → Uygulamalarınız → Web uygulaması → SDK yapılandırması
# Bu dosyayı .env olarak kopyala ve değerleri doldur. Bu değerler gizli değildir ama .env repoya girmez.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Yalnızca geliştirme: 1 yazılırsa uygulama gerçek proje yerine yerel Firebase emülatörlerine bağlanır
EXPO_PUBLIC_USE_EMULATORS=0
